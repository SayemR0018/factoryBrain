# ─── BunonBrain / factoryBrain environment ────────────────────────────────
#
# This single file is consumed by BOTH runtimes:
#   • Next.js reads variables prefixed NEXT_PUBLIC_* on the client and any
#     other key on the server side (via process.env).
#   • DotNetEnv loads the same file into ASP.NET Core at startup
#     (Program.cs calls Env.Load()).
#
# Anything you set here is shared. Do NOT commit secrets.

# ─── Frontend / Next.js ───────────────────────────────────────────────────

# Render the internal architecture page at /dev/architecture.
# Leave at false for customer builds. When false the route returns 404.
NEXT_PUBLIC_SHOW_ARCHITECTURE=false

# App display name (used in titles and the topbar).
NEXT_PUBLIC_APP_NAME=BunonBrain

# ─── Frontend → Backend bridge ────────────────────────────────────────────
# The Next.js dev server proxies /api/* to one of these URLs (in priority
# order: NEXT_PUBLIC_API_URL → DOTNET_API_URL → http://localhost:5000).
# Override per environment (e.g. http://10.0.0.5:5000 for staging).
NEXT_PUBLIC_API_URL=http://localhost:5000
DOTNET_API_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# ─── LLM adapter (optional) ───────────────────────────────────────────────
# When LLM_API_KEY is set, Ask BunonBrain and Agent runs forward to the
# model. Otherwise the deterministic demo answers are returned.

# Provider: gemini | openai | anthropic
LLM_PROVIDER=

# API key. NEVER prefix with NEXT_PUBLIC_.
LLM_API_KEY=

# Model id, e.g. gemini-1.5-pro, gpt-4.1-mini, claude-3-5-sonnet-latest.
LLM_MODEL=

# ─── RAG / Vector Retrieval (optional) ────────────────────────────────────
# When EMBEDDING_API_KEY is unset, factoryBrain falls back to a deterministic
# local semantic vectorizer (token-frequency hashing + BM25 hybrid weighting).

# Embedding provider: openai | voyage
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Hybrid retrieval knobs (also read by the .NET RagService):
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0
RAG_BM25_WEIGHT=0.35

# ─── Backend / ASP.NET Core (.NET 9) ──────────────────────────────────────

# PostgreSQL connection string. The factoryBrain backend uses pgvector.
# Make sure you have run: CREATE EXTENSION IF NOT EXISTS vector;
FACTORYBRAIN_DB=Host=localhost;Port=5432;Database=factorybrain;Username=postgres;Password=postgres

# The same keys are mirrored in appsettings.json, but env vars win.
Jwt__Issuer=factorybrain
Jwt__Audience=factorybrain
Jwt__SigningKey=change-me-to-a-long-random-string-please-32chars!

# RAG embedding dimensions (matches pgvector column vector(384)).
Rag__EmbeddingDimensions=384
Rag__TopK=4
Rag__SimilarityThreshold=0
Rag__Bm25Weight=0.35

# ASP.NET Core bind URL.
ASPNETCORE_URLS=http://localhost:5000
DOTNET_ENVIRONMENT=Development
